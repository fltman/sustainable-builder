# Copy to .env and fill in what you have. Everything is optional: without keys the site has no narrator
# (the film plays with music and ambience) and uses the bundled soundtrack. .env is git-ignored.

# ElevenLabs (the film's and the journey's narrator): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: a different narrator voice id (default: Kalmar 2126's narrator; or VOICE in vision/film.js)
# ELEVENLABS_VOICE_ID=

# Link-preview and poster art. Codex draws with its built-in image tool and needs no key.
# Claude Code can use either of these:
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Blender in an unusual place?
# BLENDER=/path/to/blender

# Swedish cities: Lantmäteriet's 1 m ground model (Markhöjdmodell, free, CC BY 4.0) instead of the
# 30 m worldwide Copernicus model. Create a free account on https://geotorget.lantmateriet.se/ and order
# access to "Markhöjdmodell Nedladdning" (Beställning). Then either your Geotorget login (Basic auth):
LANTMATERIET_USER=
LANTMATERIET_PASSWORD=
# … or an OAuth2 key pair from Lantmäteriet's API manager:
# LANTMATERIET_CONSUMER_KEY=
# LANTMATERIET_CONSUMER_SECRET=
