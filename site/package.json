{
  "name": "sustainable-builder-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The site of sustainable-builder: a research-based, Sims-like vision of a sustainable place a hundred years ahead (from Kalmar 2126).",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5230",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5230",
    "test": "node --import ./test/register.mjs --test test/*.test.mjs",
    "smoke": "node tools/smoke.mjs",
    "release": "npm test && vite build && node tools/smoke.mjs --dist",
    "shots": "node tools/shots.mjs"
  },
  "dependencies": {
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.0"
  }
}
